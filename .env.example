# ==============================================
# PORT CONFIGURATION (External Access)
# ==============================================
# Porta do MySQL (padrão: 22111)
MYSQL_PORT=22111

# Porta do Redis (padrão: 22222)
REDIS_PORT=22222

# Porta do Backend Django API (padrão: 22333)
DJANGO_PORT=22333

# Porta do Frontend React (padrão: 22444)
FRONTEND_PORT=22444

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=fastf1
MYSQL_USER=admin
MYSQL_PASSWORD=CHANGE_ME

# ==============================================
# DJANGO CONFIGURATION
# ==============================================
DEBUG=True
SECRET_KEY=CHANGE_ME
DATABASE_ENGINE=django.db.backends.mysql
DATABASE_NAME=fastf1
DATABASE_USER=admin
DATABASE_PASSWORD=CHANGE_ME
DATABASE_HOST=mysql
# Porta INTERNA do MySQL na rede Docker (sempre 3306)
DATABASE_PORT=3306

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
NODE_ENV=development
VITE_API_URL=http://localhost:22333
VITE_DOCKER_ENV=true

# ==============================================
# PYTHON CONFIGURATION
# ==============================================
PYTHONUNBUFFERED=1

# ==============================================
# NETWORK CONFIGURATION
# ==============================================
# Allowed Hosts (comma-separated) - Add your VPS IP/domain here
ALLOWED_HOSTS=localhost,127.0.0.1,django-api

# CORS Configuration (comma-separated) - Add your VPS IP/domain here
CORS_ALLOWED_ORIGINS=http://localhost:22444,http://127.0.0.1:22444

# ==============================================
# CELERY WORKER CONFIGURATION
# ==============================================
CELERY_WORKER_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=100
CELERY_PREFETCH_MULTIPLIER=1

# ==============================================
# RESOURCE LIMITS (Docker Deploy)
# ==============================================
# Redis
REDIS_MEMORY_LIMIT=256m
REDIS_MEMORY_RESERVE=128m

# MySQL
MYSQL_MEMORY_LIMIT=512m
MYSQL_MEMORY_RESERVE=256m

# Django API
DJANGO_MEMORY_LIMIT=512m
DJANGO_MEMORY_RESERVE=256m

# Celery Workers
CELERY_WORKER_CPU_LIMIT=1.0
CELERY_WORKER_CPU_RESERVE=0.25
CELERY_WORKER_MEMORY_LIMIT=512m
CELERY_WORKER_MEMORY_RESERVE=256m

# Celery Beat
CELERY_BEAT_MEMORY_LIMIT=256m
CELERY_BEAT_MEMORY_RESERVE=128m

# Frontend
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_MEMORY_RESERVE=128m

# ==============================================
# PRODUCTION SETTINGS (for VPS deployment)
# ==============================================
# Uncomment and configure for production
# DOMAIN=your-domain.com
# SSL_ENABLED=true
