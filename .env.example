# ==============================================
# PORT CONFIGURATION (External Access)
# ==============================================
# Porta do MySQL (padrão: 22111)
MYSQL_PORT=22111

# Porta do Redis (padrão: 22222)
REDIS_PORT=22222

# Porta do Backend Django API (padrão: 22333)
DJANGO_PORT=22333

# Porta do Frontend React (padrão: 22444)
FRONTEND_PORT=22444

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=fastf1
MYSQL_USER=admin
MYSQL_PASSWORD=CHANGE_ME

# ==============================================
# DJANGO CONFIGURATION
# ==============================================
DEBUG=True
SECRET_KEY=CHANGE_ME
DATABASE_ENGINE=django.db.backends.mysql
DATABASE_NAME=fastf1
DATABASE_USER=admin
DATABASE_PASSWORD=CHANGE_ME
DATABASE_HOST=mysql
# Porta INTERNA do MySQL na rede Docker (sempre 3306)
DATABASE_PORT=3306

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
NODE_ENV=development
VITE_API_URL=http://localhost:22333
VITE_DOCKER_ENV=true

# ==============================================
# PYTHON CONFIGURATION
# ==============================================
PYTHONUNBUFFERED=1

# ==============================================
# NETWORK CONFIGURATION
# ==============================================
# Allowed Hosts (comma-separated) - Add your VPS IP/domain here
ALLOWED_HOSTS=localhost,127.0.0.1,django-api

# CORS Configuration (comma-separated) - Add your VPS IP/domain here
CORS_ALLOWED_ORIGINS=http://localhost:22444,http://127.0.0.1:22444

# ==============================================
# CELERY WORKER CONFIGURATION
# ==============================================
CELERY_WORKER_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=100
CELERY_PREFETCH_MULTIPLIER=1

# ==============================================
# COLETA ADAPTATIVA (throttle por memória livre)
# ==============================================
# Custo de RAM de pico estimado por subtarefa de coleta (MB).
COLLECTION_EST_MB_PER_TASK=350
# RAM que nunca deve ser consumida - sempre mantida livre na máquina (MB).
COLLECTION_SAFETY_MARGIN_MB=2048
# Teto absoluto de subtarefas de coleta simultâneas (protege a API do FastF1).
COLLECTION_MAX_PARALLEL=6
# Intervalo de reavaliação da janela deslizante (segundos).
COLLECTION_DISPATCH_INTERVAL_SEC=20

# ==============================================
# RESOURCE LIMITS (Docker Deploy)
# ==============================================
# Redis
REDIS_CPU_LIMIT=0.5
REDIS_CPU_RESERVE=0.1
REDIS_MEMORY_LIMIT=256m
REDIS_MEMORY_RESERVE=128m

# MySQL
MYSQL_CPU_LIMIT=1.5
MYSQL_CPU_RESERVE=0.5
MYSQL_MEMORY_LIMIT=512m
MYSQL_MEMORY_RESERVE=256m

# Django API
DJANGO_CPU_LIMIT=1.0
DJANGO_CPU_RESERVE=0.25
DJANGO_MEMORY_LIMIT=512m
DJANGO_MEMORY_RESERVE=256m

# Celery Workers
# Limite maior que antes (512m): com telemetria desativada no load(), 2 processos
# por container cabem com folga; abaixo disso o Docker mata o container por OOM
# antes do throttle adaptativo conseguir agir.
CELERY_WORKER_CPU_LIMIT=1.5
CELERY_WORKER_CPU_RESERVE=0.25
CELERY_WORKER_MEMORY_LIMIT=1200m
CELERY_WORKER_MEMORY_RESERVE=384m

# Celery Beat
CELERY_BEAT_CPU_LIMIT=0.5
CELERY_BEAT_CPU_RESERVE=0.1
CELERY_BEAT_MEMORY_LIMIT=256m
CELERY_BEAT_MEMORY_RESERVE=128m

# Frontend
FRONTEND_CPU_LIMIT=0.5
FRONTEND_CPU_RESERVE=0.1
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_MEMORY_RESERVE=128m

# ==============================================
# PRODUCTION SETTINGS (for VPS deployment)
# ==============================================
# Uncomment and configure for production
# DOMAIN=your-domain.com
# SSL_ENABLED=true
