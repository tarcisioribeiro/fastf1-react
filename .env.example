# ==============================================
# PORT CONFIGURATION (External Access)
# ==============================================
# Porta do MySQL (padrão: 3306)
MYSQL_PORT=3306

# Porta do Redis (padrão: 6379)
REDIS_PORT=6379

# Porta do Backend Django API (padrão: 8000)
DJANGO_PORT=8000

# Porta do Frontend React (padrão: 3000)
FRONTEND_PORT=3000

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=f1_database
MYSQL_USER=f1_user
MYSQL_PASSWORD=f1_password

# ==============================================
# DJANGO CONFIGURATION
# ==============================================
DEBUG=True
SECRET_KEY=django-insecure-development-key-change-in-production
DATABASE_ENGINE=django.db.backends.mysql
DATABASE_NAME=f1_database
DATABASE_USER=f1_user
DATABASE_PASSWORD=f1_password
DATABASE_HOST=mysql
DATABASE_PORT=3306

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
NODE_ENV=development
VITE_API_URL=http://localhost:8000

# ==============================================
# NETWORK CONFIGURATION
# ==============================================
# Allowed Hosts (comma-separated) - Add your VPS IP/domain here
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration (comma-separated) - Add your VPS IP/domain here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================
# PRODUCTION SETTINGS (for VPS deployment)
# ==============================================
# Uncomment and configure for production
# DOMAIN=your-domain.com
# SSL_ENABLED=true
